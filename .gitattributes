* text=auto
# Windows 에서 clone 하면 줄 끝이 CRLF 로 바뀔 수 있는데, bash 는 \r 을 명령의 일부로 읽어 깨진다.
*.sh text eol=lf
# install.ps1 이 ~/.wslconfig 와 해시로 비교하므로 줄 끝이 바뀌면 안 된다.
wslconfig text eol=lf
# Windows 쪽 clone 에서 CRLF 로 바뀌면 Debian 의 docker build 가 그 파일을 그대로 읽는다. 셸과 같은 이유로 LF 고정.
Dockerfile text eol=lf
requirements.txt text eol=lf
compose.yaml text eol=lf
# bin/ 의 확장자 없는 셸 스크립트도 Debian 에서 그대로 돈다.
bin/* text eol=lf
